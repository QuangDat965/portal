{
	email {$ACME_EMAIL}
}

{$PORTAL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

{$DEMO_DOMAIN} {
	encode zstd gzip
	reverse_proxy demo:5174
}

{$TASKS_DOMAIN} {
	encode zstd gzip
	reverse_proxy tasks:8080
}

{$NOTES_DOMAIN} {
	encode zstd gzip
	reverse_proxy notes:8080
}

{$KITTENS_DOMAIN} {
	encode zstd gzip
	reverse_proxy kittens:8080
}
