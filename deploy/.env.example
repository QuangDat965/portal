# ---------------------------------------------------------------------------
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# ---------------------------------------------------------------------------

# Domain công khai
PORTAL_DOMAIN=portal.example.com
DEMO_DOMAIN=demo.example.com
TASKS_DOMAIN=tasks.example.com
NOTES_DOMAIN=notes.example.com
PUBLIC_PORTAL_URL=https://portal.example.com
PUBLIC_DEMO_URL=https://demo.example.com
PUBLIC_TASKS_URL=https://tasks.example.com
PUBLIC_NOTES_URL=https://notes.example.com
ACME_EMAIL=admin@example.com

# Google OAuth (Authorized redirect URI: https://portal.example.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=doi-mat-khau-manh

# Bảo mật — bắt buộc đổi
SECRET_PEPPER=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
DEMO_CLIENT_SECRET=chuoi-ngau-nhien-khac
TASKS_CLIENT_SECRET=chuoi-ngau-nhien-cho-tasks
NOTES_CLIENT_SECRET=chuoi-ngau-nhien-cho-notes

# Seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Portal Admin
# Mật khẩu đăng nhập cục bộ cho admin (tối thiểu 12 ký tự). Để trống nếu chỉ dùng Google.
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true

# Chỉ bật khi phát triển
ALLOW_DEV_LOGIN=false
